# Local demonstration only; set your own SMTP account and app password.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=587
SMTP_USER=your_email@yandex.ru
SMTP_PASSWORD=replace-with-mail-app-password

# API and worker must share the same files and absolute data path.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
IMAGE_SERVICE_DATA_DIR=.
SUBSCRIBERS_DATABASE_URL=sqlite:///subscribers.db
